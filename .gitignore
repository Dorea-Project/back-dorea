# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Environnements virtuels
.venv/
venv/

# Secrets / config locale
.env
# Toute copie de l'environnement porte les memes secrets que l'original.
# `.env.sauvegarde-otp` a ete cree le 22/08 pour neutraliser Infobip le temps de
# lire un OTP en console : il contient la cle, et rien ne l'empechait d'etre
# commite.
.env.*
!.env.example

# Outils
.coverage
htmlcov/

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# La documentation est **versionnee** : 25 documents l'etaient deja quand `docs/` a ete
# ignore, ce qui creait une frontiere invisible ou les specs recentes disparaissaient.
# Pour des notes de travail, utiliser `docs/scratch/`.
docs/scratch/
.claude
# Le telechargement brut de la LSG (~10 Mo) est un INTERMEDIAIRE : `scripts/build_lsg_dataset.py`
# le convertit en `data/ls1910.json`, qui lui est versionne. Versionner les deux stockerait deux
# fois la meme Bible, dont une que rien ne lit.
data/ls1910_raw.json
data/morphgnt/
# Même raison pour l'hébreu : 53 Mo de WLC et de lexique Strong, retéléchargeables en une
# commande et déjà dépliés en base par `urim_seed_hebrew.py`.
data/morphhb/
# La file du relecteur se recalcule à chaque passage du détecteur — la versionner figerait
# une photo que le prochain lot de curation démentirait.
data/urim_file_relecture.txt
# La copie de sauvegarde avant régénération d'un lot : un intermédiaire qui sert à comparer
# deux régimes de curation, puis ne sert plus. La base fait foi.
data/urim_caveats_ancienne_invite.json
# Les téléchargements bruts des traductions — ~10 Mo chacun, remis en cache par
# `urim_seed_version.py` et déjà dépliés en base. Même règle que la LSG brute.
data/*_raw.json
# Le lexique TBESG (4,7 Mo, STEPBible CC BY 4.0) : même règle que MorphGNT et la WLC —
# retéléchargeable en une commande, et déjà déplié en base par `urim_seed_lexique.py`, qui
# en garde l'entrée d'origine dans `gloss_source`. Versionner la source stockerait deux fois
# la même chose, dont une que rien ne lit.
#
# ⚠️ L'attribution, elle, ne s'ignore pas : elle est portée par `gloss_source_ref` sur chaque
# ligne et affichée dans la note du prédicateur, comme la licence l'exige.
data/stepbible/
data/*_raw.xml
# Les verdicts du contre-interrogatoire : une trace de reprise, pas une source. La base
# fera foi quand les worktrees auront fusionne et que ce sera une table.
data/urim_contre_interrogatoire.json
# Les fragments televerses par les telephones : de la voix de pasteur, pas de la source.
# D53 leur donne sept jours et `urim_purger_audio.py` les efface — mais l'historique de git,
# lui, n'oublie pas. Un seul `git add .` rendrait definitif ce que la purge existe
# precisement pour rendre temporaire, et une fois pousse ca ne se retire plus vraiment.
capture_audio/
