# --- Application ---
APP_NAME=dorea-mobile-api
ENVIRONMENT=local
DEBUG=true
API_PREFIX=/api/mobile

# --- Base PostgreSQL (schéma détenu par ce backend) ---
# Format asyncpg. Ce backend lit, écrit et fait évoluer le schéma (migrations à venir).
DATABASE_URL=postgresql+asyncpg://dorea:dorea@localhost:5432/dorea
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- Auth (M2) — secret/algo de hash cohérents entre les canaux backoffice + mobile ---
JWT_SECRET=change-me-in-env
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=2592000

# --- CORS ---
# Liste JSON : CORS_ORIGINS=["https://app.dorea.church"]
CORS_ORIGINS=["*"]

# --- Backoffice (surface PWA) ---
# Provisionnement = acte Plateforme, protégé par ce jeton (en-tête X-Service-Token)
# tant que l'auth session backoffice (S3/M2) n'est pas en place.
BACKOFFICE_PREFIX=/api/backoffice
BACKOFFICE_SERVICE_TOKEN=change-me-service-token

# --- Messagerie (Infobip : WhatsApp + SMS de repli) ---
# Un seul numero pour toute la plateforme (decision M1, docs/Messagerie_Architecture.md).
# Non configure -> tout part au journal, sans le code ni le numero (le dev tourne sans compte).
# L'hote est propre au compte Infobip : le lire dans le portail, ne pas le deviner.
INFOBIP_BASE_URL=https://xxxxx.api.infobip.com
INFOBIP_API_KEY=change-me
# Numero emetteur WhatsApp, international sans « + ».
WHATSAPP_SENDER=
# Modele approuve pour les codes de connexion — categorie `authentication` chez
# l'operateur, la seule autorisee a porter un code.
WHATSAPP_OTP_TEMPLATE=dorea_otp
WHATSAPP_OTP_LANGUAGE=fr
# Le modele porte-t-il un bouton « Copier le code » ? Les modeles
# d'authentification de WhatsApp en ont presque toujours un, et sa variable se
# renseigne a part du corps : l'oublier fait refuser l'envoi.
WHATSAPP_OTP_COPY_CODE_BUTTON=true

# Secret partage des webhooks Infobip (en-tete `X-Dorea-Webhook-Token`).
# Infobip ne signe pas ses appels : ce jeton est la seule barriere, a traiter
# comme un mot de passe. Non configure -> les routes repondent 404.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MESSAGING_WEBHOOK_TOKEN=
# Ou le fournisseur nous rappelle (accuses de reception). Posee sur chaque envoi
# plutot que dans le portail : le compte est unique, les environnements non.
# En local, un tunnel : https://xxxx.ngrok-free.app/api/webhooks/infobip/reports
MESSAGING_NOTIFY_URL=
