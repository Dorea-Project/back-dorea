# --- Application ---
APP_NAME=dorea-mobile-api
ENVIRONMENT=local
DEBUG=true
API_PREFIX=/api/mobile

# --- Base PostgreSQL (schéma détenu par ce backend) ---
# Format asyncpg. Ce backend lit, écrit et fait évoluer le schéma (migrations à venir).
DATABASE_URL=postgresql+asyncpg://dorea:dorea@localhost:5432/dorea
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- Auth (M2) — secret/algo de hash cohérents entre les canaux backoffice + mobile ---
JWT_SECRET=change-me-in-env
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=2592000

# --- CORS ---
# Liste JSON : CORS_ORIGINS=["https://app.dorea.church"]
CORS_ORIGINS=["*"]

# --- Backoffice (surface PWA) ---
# Provisionnement = acte Plateforme, protégé par ce jeton (en-tête X-Service-Token)
# tant que l'auth session backoffice (S3/M2) n'est pas en place.
BACKOFFICE_PREFIX=/api/backoffice
BACKOFFICE_SERVICE_TOKEN=change-me-service-token
